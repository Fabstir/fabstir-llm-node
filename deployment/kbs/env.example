# /etc/fabstir-kbs/env (mode 0640 root:fabstir-kbs). Design §2 lists every variable;
# absent = default. The broker never reads HOST_TEE_ENABLED or TEE_*.
KBS_LISTEN=127.0.0.1:3030
KBS_DATA_DIR=/var/lib/fabstir-kbs
# real | canned  (canned forces the TEST keyring: every entry test: true)
KBS_GPU_EVIDENCE=real
# real | simulator (simulator forces the TEST keyring)
KBS_CPU_EVIDENCE=real
KBS_PCCS_URL=https://pccs.phala.network
KBS_NRAS_GPU_URL=https://nras.attestation.nvidia.com/v3/attest/gpu
KBS_NRAS_JWKS_URL=https://nras.attestation.nvidia.com/.well-known/jwks.json
KBS_NRAS_ISSUER=https://nras.attestation.nvidia.com
KBS_NRAS_CLAIMS_VERSION=2.0
KBS_NONCE_TTL_SECS=300
RUST_LOG=info
