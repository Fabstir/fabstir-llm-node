# UK host on 3XS-Z (docker-compose.uk-3xsz.yml, scripts/uk-host)
# Copy to .env.uk-3xsz beside this file and fill in. No secret values here.
# Every variable without a default below is REQUIRED: the compose file stops the start if one is missing.
# The S5 region, portal and peer are fixed in the compose file (UK only) and are not set here.

# ---- Secrets (required) ----
# Host key of TEST_HOST_1, address 0x4594F755F593B517Bb3194F4DeC20C48a3f04504 (plan D8).
# NOT host1's key (that one is labelled TEST_HOST_4): using it would re-point host1's registration.
HOST_PRIVATE_KEY=
# A FRESH 12 word S5 seed for the UK bridge, never used on Global or any other region (SR1 D3)
S5_SEED_PHRASE=
# Bearer token for the node's GET /v1/sessions/active, used by scripts/uk-host stop and status.
# Any long random string, e.g. openssl rand -hex 32
ACTIVE_SESSIONS_TOKEN=

# ---- Model folder (required) ----
# The Hugging Face cache folder of the model on F:, mounted read-only whole (note the folder is spelled huggineface)
QWEN_FLASH_NEXT_DIR=/mnt/f/Users/jabus/.cache/huggineface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF

# ---- Chain, Base Sepolia (all required) ----
# House default RPC (Alchemy is off, memory alchemy-off-rpc-endpoints)
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
# Contract addresses as in .env.contracts on 27 November 2026 (that file is the single source of truth)
CONTRACT_JOB_MARKETPLACE=0xD067719Ee4c514B5735d1aC0FfB46FECf2A9adA4
CONTRACT_NODE_REGISTRY=0x8BC0Af4aAa2dfb99699B1A24bA85E507de10Fd22
CONTRACT_PROOF_SYSTEM=0xE8DCa89e1588bbbdc4F7D5F78263632B35401B31
CONTRACT_HOST_EARNINGS=0xE4F33e9e132E60fc3477509f99b9E1340b91Aee0
CONTRACT_MODEL_REGISTRY=0x1a9d91521c85bD252Ac848806Ff5096bBb9ACDb2
USDC_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e
FAB_TOKEN=0xC78949004B4EB6dEf2D66e49Cd81231472612D62
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# ---- Optional ----
# Model validation against the registry: set true from U7, after the model is approved and the host registered
# (default false; with true the node exits at start while the model is not approved)
# REQUIRE_MODEL_VALIDATION=true
# API port on 127.0.0.1 (Tailscale Funnel forwards to it); default 8083
# API_PORT=8083
# Experts in RAM by layer count, and threads: leave unset until the U4 measurements say otherwise (plan Q1, D2, D4)
# LLAMA_CPU_MOE_LAYERS=
# LLAMA_THREADS=
# LLAMA_THREADS_BATCH=
# RUST_LOG=info
# LOG_LEVEL=info

# ---- scripts/uk-host only (read from this file too) ----
# Free VRAM needed before start, in MiB (default 90000, PROVISIONAL: set from the U4 measurement)
# UK_HOST_MIN_FREE_MIB=90000
# How long start waits for the model to load, in seconds (default 1800)
# UK_HOST_START_TIMEOUT_SECS=1800
# The public Funnel URL, for `uk-host status`
# UK_HOST_PUBLIC_URL=https://<machine>.<tailnet>.ts.net
