# @fabstir/fiat-service — environment
#
# Copy to .env and fill in. NOTHING here is committed (.env* is gitignored except
# this example). The FIAT_* secrets are runtime-only. The NEXT_PUBLIC_* values are
# inlined by Next AT BUILD TIME, so they must be present when you run `next build`
# (see README "Deploy"), not only at runtime.

# ---- Stripe (server-to-server; test keys for test mode) ----
FIAT_STRIPE_SECRET_KEY=sk_test_xxx          # FULL secret key (sk_...), NOT a restricted rk_ key
FIAT_STRIPE_WEBHOOK_SECRET=whsec_xxx        # from the Stripe webhook endpoint for /v1/fiat/stripe/webhook
FIAT_STRIPE_CURRENCY=usd                    # charge currency; usd = credits are 1:1 US cents (Model A, no FX)

# ---- Vault + backend signing keys (SECRETS — never NEXT_PUBLIC_, never logged) ----
FIAT_VAULT_PRIVATE_KEY=0x...                # the on-chain depositor wallet (pre-funded USDC treasury float)
FIAT_BACKEND_AUTH_PRIVATE_KEY=0x...         # signs the FC1.6 session-auth digest presented to the node
FIAT_ADMIN_TOKEN=                           # bearer token guarding the operator route POST /v1/fiat/credential

# ---- Ledger + credential journals (users' money — back up out of band) ----
FIAT_DATA_DIR=./data/fiat                   # code default; single instance only — a nonce/balance here is invisible to a replica

# ---- Limits / windows ----
FIAT_MAX_PURCHASE_CREDITS=                  # cap per purchase (integer credits); unset = library default
FIAT_CHALLENGE_MAX=                         # global live-challenge cap before 429; unset = library default
FIAT_REFUND_WINDOW_DAYS=                    # cash-out refund window; unset = library default
FIAT_ALLOWED_HOSTS=                         # comma-separated host allowlist for session provisioning (gatekeeper)
FIAT_TREASURY_ADDRESS=                      # treasury address used by the settlement/reconcile path

# ---- Gatekeeper + vault caps (micro-USDC bigints; read via bigintEnv, safe defaults) ----
FIAT_MAX_SESSION_DEPOSIT_MICRO=             # per-session deposit cap (default 2000000 = $2)
FIAT_MAX_DAILY_SPEND_MICRO=                 # per-user daily spend cap (default 10000000 = $10)
FIAT_MAX_OPENS_PER_MINUTE=                  # session-open rate cap per user (default 3)
FIAT_VAULT_ALLOWANCE_FLOAT_MICRO=           # standing USDC approve() float to the marketplace (default 2000000 = $2)

# ---- Stripe Checkout redirect URLs (the UI's pages) ----
FIAT_PURCHASE_SUCCESS_URL=https://your-ui.example/credits?status=success
FIAT_PURCHASE_CANCEL_URL=https://your-ui.example/credits?status=cancel

# ---- CORS (NEW for the standalone service) ----
# Comma-separated allowed browser origins. A single "*" allows any origin (fine
# here: routes are self-authenticating and use no cookies). Prefer explicit
# origins in production, e.g. https://platformlessai.ai,https://blender.example
FIAT_CORS_ALLOWED_ORIGINS=*

# ---- Settlement listener (FC1.3; inert unless enabled) ----
FIAT_SETTLEMENT_ENABLED=                    # set to 1 to start the on-chain settlement listener at boot
FIAT_SETTLEMENT_FROM_BLOCK=                 # optional starting block for the listener
FIAT_SETTLEMENT_SAFETY_LAG=                 # scan only to head−N blocks (default 5) — lagging-replica protection
FIAT_SETTLEMENT_OVERLAP_BLOCKS=             # re-scan N blocks behind the cursor each tick (default 30; idempotent)
FIAT_SETTLEMENT_TICK_TIMEOUT_MS=            # watchdog: abandon a hung tick after this (default 120000)
FIAT_SETTLEMENT_HEARTBEAT_EVERY=            # liveness line every N ticks (default 40 ≈ 10 min); 0 disables

# ---- Chain config (read server-side; INLINED AT BUILD TIME — must be set for `next build`) ----
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CONTRACT_JOB_MARKETPLACE=0xD067719Ee4c514B5735d1aC0FfB46FECf2A9adA4
NEXT_PUBLIC_USDC_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# REQUIRED: the host directory. Every session is priced by reading
# getModelPricing(host, modelId, token) from it, because pricing is per model
# per host (LTX video 904, chat models 10000). Without this, opens fail.
NEXT_PUBLIC_CONTRACT_NODE_REGISTRY=0x8BC0Af4aAa2dfb99699B1A24bA85E507de10Fd22
# NOTE: host + model id are NOT service config — every POST /v1/fiat/session carries
# them in its body, and the gatekeeper checks the host against FIAT_ALLOWED_HOSTS.
# These two are exported helpers with no live consumer in this service; leave unset.
NEXT_PUBLIC_TEST_HOST=                      # unused by current service code paths
NEXT_PUBLIC_LTX_MODEL_ID=                   # unused by current service code paths
NEXT_PUBLIC_SESSION_PRICE_PER_TOKEN=        # NO LONGER A PRICING SOURCE: the registry is (see NODE_REGISTRY above).
                                            # A single constant here priced every model at the LTX rate, which the
                                            # contract rejects ("Low price") for any model registered higher. Unused.
