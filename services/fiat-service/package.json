{
  "name": "@fabstir/fiat-service",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone shared fiat-credits service (vault + ledger + Stripe) for the Platformless AI UI, the Blender website and the Blender extension. One vault, one ledger, one Stripe account, the same smart contracts.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3020",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3020",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "2.55.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
