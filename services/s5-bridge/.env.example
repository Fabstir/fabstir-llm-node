# Enhanced S5.js Bridge Service Configuration

# HTTP Server
BRIDGE_PORT=5522
BRIDGE_HOST=localhost

# S5 Identity (REQUIRED)
# Generate with: node -e "import('@julesl23/s5js').then(({S5}) => S5.generateSeedPhrase().then(console.log))"
S5_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Host Ethereum Private Key (REQUIRED for on-chain verified portal registration)
# This must match the address registered on NodeRegistry
# Same key used for checkpoint submission and settlements
HOST_PRIVATE_KEY=0x...

# Storage region (REQUIRED, no default): global or uk. The portal and peer
# hosts below must belong to it, or the bridge refuses to start.
S5_REGION=global

# S5 Network (Platformless AI Portal - Sia Storage)
S5_PORTAL_URL=https://s5.platformlessai.ai
S5_INITIAL_PEERS=wss://z2DcjTLqfj6PTMsDbFfgtuHtYmrKeibFTkvqY8QZeyR3YmE@s5.platformlessai.ai/s5/p2p

# Logging
LOG_LEVEL=info
PRETTY_LOGS=true

# Performance
REQUEST_TIMEOUT_MS=30000
MAX_CONTENT_LENGTH=104857600
