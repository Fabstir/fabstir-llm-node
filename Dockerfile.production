FROM nvidia/cuda:13.0.0-runtime-ubuntu22.04 AS runtime
# libnccl2 is deliberately NOT installed here: the cuda:13.0.0 base image ships
# it pre-installed and version-HELD at the CUDA-matched version. Listing it makes
# apt try to upgrade a held package whenever NVIDIA's repo moves ahead, which
# fails the build ("Held packages were changed and -y was used without
# --allow-change-held-packages"). The held base version is the one we want.
RUN apt-get update && apt-get install -y \
    curl ca-certificates \
    libgomp1 \
    libssl-dev \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*
# AI provenance AP2 (D3, D18): the PINNED ffmpeg whose MPEG-7 `signature` filter fingerprints every delivered
# picture. GPL static build (vf_signature needs --enable-gpl): shipped as a separate executable the node runs,
# never linked. Both the release tarball and the binary are hash-checked; the node checks the binary again at
# startup (PROVENANCE_FFMPEG) and refuses to enable LTX on any mismatch.
ARG FFMPEG_URL=https://johnvansickle.com/ffmpeg/old-releases/ffmpeg-7.0.2-amd64-static.tar.xz
ARG FFMPEG_TAR_SHA256=abda8d77ce8309141f83ab8edf0596834087c52467f6badf376a6a2a4c87cf67
ARG FFMPEG_SHA256=e7e7fb30477f717e6f55f9180a70386c62677ef8a4d4d1a5d948f4098aa3eb99
RUN curl -fsSL "$FFMPEG_URL" -o /tmp/ffmpeg.tar.xz \
    && echo "$FFMPEG_TAR_SHA256  /tmp/ffmpeg.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp \
    && install -D -m 0755 /tmp/ffmpeg-7.0.2-amd64-static/ffmpeg /opt/provenance/ffmpeg \
    && install -m 0644 /tmp/ffmpeg-7.0.2-amd64-static/GPLv3.txt /opt/provenance/ffmpeg-GPLv3.txt \
    && echo "$FFMPEG_SHA256  /opt/provenance/ffmpeg" | sha256sum -c - \
    && rm -rf /tmp/ffmpeg.tar.xz /tmp/ffmpeg-7.0.2-amd64-static
ENV PROVENANCE_FFMPEG=/opt/provenance/ffmpeg
WORKDIR /app
# Binary is mounted from host via docker-compose volume
# Models are mounted from host via docker-compose volume
EXPOSE 9000 9001 9002 8080
CMD ["fabstir-llm-node"]
