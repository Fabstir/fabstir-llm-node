{
  "allowListVersion": 3,
  "templates": [
    { "templateId": "ltx-t2v-hdr", "version": "v1" },
    { "templateId": "ltx-i2v-hdr", "version": "v1", "imageInputs": 1, "imageSemantics": ["firstFrame"] },
    { "templateId": "ltx-flf2v-hdr", "version": "v1", "imageInputs": 2, "imageSemantics": ["firstFrame", "lastFrame"] }
  ],
  "loras": ["ltx-iclora-hdr@v1"],
  "bounds": {
    "frames": { "min": 1, "max": 257 },
    "fps": [24, 25, 30],
    "resolutions": [
      { "w": 768, "h": 512 },
      { "w": 1280, "h": 720 }
    ],
    "imageMaxBytes": 8388608,
    "imageFormats": ["png", "jpeg", "webp"]
  }
}
